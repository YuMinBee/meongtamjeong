# Contest/demo defaults. Copy to .env and replace placeholder values.
API_KEY=change-me

# Never present known inactive or status-unknown notices as live demo candidates.
NOTICE_FILTER_INACTIVE=true
NOTICE_INCLUDE_UNKNOWN=false
PROFILE_INCLUDE_UNKNOWN_NOTICES=false

# Use an active-only, readiness-checked snapshot.
INDEX_PATH=./data/dog_faiss.contest.index
METAS_PATH=./data/dog_metas.contest.json

# Reranking weights remain explicit and auditable.
PROFILE_COMPATIBILITY_WEIGHT=0.25
PROFILE_QUALITY_WEIGHT=0.05
PROFILE_CANDIDATE_MULTIPLIER=5

# Optional model endpoints stay disabled unless terms and hardware are prepared.
GEMMA3_ENABLED=false
GEMMA3_MODEL_PATH=
GEMMA3_MODEL_ID=google/gemma-3-12b-it
VLM_MODEL_PATH=
ANIMAL_API_KEY=
