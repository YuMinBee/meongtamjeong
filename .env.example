# 로컬 실행용 예시 환경변수
# 실제 키/값은 .env에 넣고 이 파일은 예시로만 사용하세요.

# API 보호용 키 (요청 헤더: x-api-key)
APP_ENV=development
API_KEY=change-me
# 쉼표로 구분한 브라우저 허용 출처. 같은 origin의 /demo에는 CORS가 필요하지 않습니다.
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 공고 상태 필터
NOTICE_FILTER_INACTIVE=true
# 기존 검색 API의 unknown 포함 정책(기존 기본값 유지)
NOTICE_INCLUDE_UNKNOWN=false

# 생활조건 기반 후보 재정렬
PROFILE_COMPATIBILITY_WEIGHT=0.25
PROFILE_QUALITY_WEIGHT=0.05
PROFILE_CANDIDATE_MULTIPLIER=5
# 상태 메타가 없는 기존 인덱스도 상담 필요 표시와 함께 프로필 검색에 포함
PROFILE_INCLUDE_UNKNOWN_NOTICES=true

# FAISS 인덱스/메타 경로
INDEX_PATH=./data/dog_faiss.index
METAS_PATH=./data/dog_metas.json

# CLIP 모델 이름
CLIP_MODEL=ViT-B/32

# Gemma 3 로컬 snapshot 경로 또는 모델 ID
GEMMA3_ENABLED=false
GEMMA3_MODEL_PATH=
GEMMA3_MODEL_ID=google/gemma-3-12b-it

# 오프라인 사진 속성 추출용 VLM 설정
# Qwen 계열처럼 범용 image-text 모델은 VLM_MODEL_CLASS=auto를 사용하세요.
VLM_MODEL_PATH=
VLM_MODEL_ID=google/gemma-3-12b-it
VLM_MODEL_CLASS=gemma3

# Gemma 실행 메모리 설정
GEMMA3_GPU_MAX_MEMORY=20GiB
GEMMA3_CPU_MAX_MEMORY=96GiB

# 공공 유기동물 API 키가 필요하면 사용하세요.
ANIMAL_API_KEY=
# 보호소 문의 시 최신 공고 재조회 총시간·성공 결과 캐시(TTL)
NOTICE_LOOKUP_TIMEOUT_SECONDS=12
NOTICE_LOOKUP_CACHE_TTL_SECONDS=300
NOTICE_LOOKUP_MAX_CONCURRENCY=2

# 업로드 이미지 제한 (기본 8 MiB, 디코딩 후 최대 2,500만 픽셀)
IMAGE_UPLOAD_MAX_BYTES=8388608
IMAGE_UPLOAD_MAX_PIXELS=25000000

# Optional CLIP-text + DINOv3-image shared-space rollout.
# off: existing CLIP path only; shadow: run DINO but serve CLIP; active: serve DINO.
DINO_FUSION_MODE=off
DINO_FUSION_TEXT_WEIGHT=0.20
# Research-only weak-label branch. Keep disabled unless running its isolated study.
DINO_FUSION_BEHAVIOR_ENABLED=false
DINO_FUSION_BEHAVIOR_WEIGHT=0.25
DINO_FUSION_LOCAL_FILES_ONLY=true
DINO_FUSION_FAIL_OPEN=true
DINO_FUSION_DEVICE=auto
# Optional artifact path overrides. Empty values use experiments/dino_fusion/artifacts/.
DINO_FUSION_DINO_DIR=
DINO_FUSION_FLOW_DIR=
DINO_FUSION_BEHAVIOR_DIR=
